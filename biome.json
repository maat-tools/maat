{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNestedTernary": "error",
				"useBlockStatements": "error",
				"useConsistentMemberAccessibility": {
					"level": "error",
					"options": { "accessibility": "explicit" }
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"files": {
		"includes": ["**", "!**/node_modules", "!**/dist", "!docs/.vitepress", "!**/package.json", "!**/fixtures"]
	}
}
