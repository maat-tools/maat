{
	"name": "maat",
	"version": "0.4.0",
	"private": true,
	"description": "Turn implicit architecture knowledge into deterministic checks — captures coupling, boundaries, and codebase rules that usually live in developers' heads.",
	"keywords": [
		"architecture",
		"governance",
		"coupling",
		"connascence",
		"typescript",
		"static-analysis",
		"ledger"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/maat-tools/maat"
	},
	"workspaces": [
		"packages/*",
		"tests"
	],
	"scripts": {
		"build": "for pkg in contracts vocabulary utils core kernel collector-ts collector-git enricher-llm coupling-rules connascence-rules presets-ts git-rules insights file-ledger cli; do bun run --cwd packages/$pkg build || exit 1; done",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"lint": "biome check .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "bun test packages",
		"test:e2e": "bun test tests/e2e",
		"test:pack": "bash scripts/smoke-pack.sh",
		"typecheck": "tsc --noEmit",
		"maat": "bun run packages/cli/src/index.ts",
		"maat:node": "bun run build && node packages/cli/dist/index.js",
		"commitlint": "commitlint --from HEAD~1 --to HEAD"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@maat-tools/collector-ts": "workspace:*",
		"@maat-tools/enricher-llm": "workspace:*",
		"@maat-tools/connascence-rules": "workspace:*",
		"@maat-tools/coupling-rules": "workspace:*",
		"@maat-tools/file-ledger": "workspace:*",
		"@types/bun": "1.3.14",
		"typescript": "6.0.3",
		"vitepress": "1.6.4"
	}
}
