{
  "name": "@maat-tools/cli",
  "version": "0.1.7",
  "description": "Command-line interface for maat — loads plugins, runs analysis and manages the finding lifecycle",
  "type": "module",
  "bin": {
    "maat": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --packages external --banner '#!/usr/bin/env node' && bun build src/spinner-worker.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@biomejs/biome": "2.4.14"
  },
  "dependencies": {
    "@maat-tools/collector-git": "0.1.6",
    "@maat-tools/collector-ts": "0.1.6",
    "@maat-tools/connascence-rules": "0.1.6",
    "@maat-tools/contracts": "0.1.6",
    "@maat-tools/core": "0.1.6",
    "@maat-tools/coupling-rules": "0.1.6",
    "@maat-tools/file-ledger": "0.1.6",
    "@maat-tools/git-rules": "0.1.6",
    "@maat-tools/insights": "0.1.6",
    "@maat-tools/kernel": "0.1.6",
    "chalk": "^5.6.2",
    "commander": "14.0.3"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/cli"
  }
}
