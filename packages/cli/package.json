{
  "name": "@maat-tools/cli",
  "version": "0.5.0",
  "description": "Command-line interface for maat — loads plugins, runs analysis and manages the finding lifecycle",
  "type": "module",
  "bin": {
    "maat": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --packages external --banner '#!/usr/bin/env node' && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.5.0",
    "@maat-tools/testing": "workspace:*",
    "@maat-tools/utils": "workspace:*"
  },
  "dependencies": {
    "@maat-tools/contracts": "workspace:*",
    "@maat-tools/core": "workspace:*",
    "@maat-tools/kernel": "workspace:*",
    "commander": "15.0.0",
    "yocto-spinner": "1.2.2"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/cli"
  }
}
