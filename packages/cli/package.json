{
	"name": "@maat-tools/cli",
	"version": "0.1.0",
	"description": "Command-line interface for maat — loads plugins, runs analysis and manages the finding lifecycle",
	"type": "module",
	"bin": {
		"maat": "./dist/index.js"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --format esm --target node --packages external --banner '#!/usr/bin/env node' && bun build src/spinner-worker.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
		"dev": "bun run src/index.ts",
		"lint": "biome check .",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"@biomejs/biome": "2.4.15"
	},
	"dependencies": {
		"@maat-tools/collector-git": "workspace:*",
		"@maat-tools/collector-ts": "workspace:*",
		"@maat-tools/connascence-rules": "workspace:*",
		"@maat-tools/contracts": "workspace:*",
		"@maat-tools/core": "workspace:*",
		"@maat-tools/coupling-rules": "workspace:*",
		"@maat-tools/file-ledger": "workspace:*",
		"@maat-tools/git-rules": "workspace:*",
		"@maat-tools/insights": "workspace:*",
		"@maat-tools/kernel": "workspace:*",
		"chalk": "^5.6.2",
		"commander": "14.0.3"
	},
	"author": "Marcos Defendi (https://github.com/maat-tools)",
	"homepage": "https://maat-tools.github.io/maat/",
	"repository": {
		"type": "git",
		"url": "https://github.com/maat-tools/maat",
		"directory": "packages/cli"
	}
}
