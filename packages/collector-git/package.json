{
	"name": "@maat-tools/collector-git",
	"version": "0.1.0",
	"description": "Git history collector that extracts commits and file changes for use in maat rules",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
		"dev": "bun run src/index.ts",
		"lint": "biome check .",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"@biomejs/biome": "2.4.14"
	},
	"dependencies": {
		"@maat-tools/contracts": "workspace:*"
	},
	"author": "Marcos Defendi (https://github.com/maat-tools)",
	"homepage": "https://maat-tools.github.io/maat/",
	"repository": {
		"type": "git",
		"url": "https://github.com/maat-tools/maat",
		"directory": "packages/collector-git"
	}
}
