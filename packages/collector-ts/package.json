{
  "name": "@maat-tools/collector-ts",
  "version": "0.5.0",
  "description": "TypeScript source collector that extracts imports and constants from a project via ts-morph",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast-worker": {
      "bun": "./src/workers/collect-ast-facts-worker.ts",
      "import": "./dist/workers/collect-ast-facts-worker.js",
      "types": "./dist/workers/collect-ast-facts-worker.d.ts",
      "default": "./dist/workers/collect-ast-facts-worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/workers/collect-ast-facts-worker.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.5.3"
  },
  "dependencies": {
    "@cs-au-dk/jelly": "0.13.0",
    "@maat-tools/contracts": "workspace:*",
    "@maat-tools/utils": "workspace:*",
    "@maat-tools/vocabulary": "workspace:*",
    "execa": "9.6.1",
    "tinyglobby": "0.2.17",
    "ts-morph": "28.0.0",
    "typescript": "7.0.2"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/collector-ts"
  }
}
