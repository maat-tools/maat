{
  "name": "@maat-tools/connascence-rules",
  "version": "0.1.9",
  "description": "Built-in rules for detecting connascence — meaning (shared literals) and position (heterogeneous returns)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./com": {
      "bun": "./src/com/com.ts",
      "import": "./dist/com/com.js",
      "types": "./dist/com/com.d.ts",
      "default": "./dist/com/com.js"
    },
    "./cop": {
      "bun": "./src/cop/index.ts",
      "import": "./dist/cop/index.js",
      "types": "./dist/cop/index.d.ts",
      "default": "./dist/cop/index.js"
    },
    "./cop-args": {
      "bun": "./src/cop/args.ts",
      "import": "./dist/cop/args.js",
      "types": "./dist/cop/args.d.ts",
      "default": "./dist/cop/args.js"
    },
    "./cop-struct": {
      "bun": "./src/cop/struct.ts",
      "import": "./dist/cop/struct.js",
      "types": "./dist/cop/struct.d.ts",
      "default": "./dist/cop/struct.js"
    },
    "./coa-technical": {
      "bun": "./src/coa/technical.ts",
      "import": "./dist/coa/technical.js",
      "types": "./dist/coa/technical.d.ts",
      "default": "./dist/coa/technical.js"
    },
    "./com-semantic": {
      "bun": "./src/com/com-semantic.ts",
      "import": "./dist/com/com-semantic.js",
      "types": "./dist/com/com-semantic.d.ts",
      "default": "./dist/com/com-semantic.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/com/com.ts src/com/com-semantic.ts src/cop/index.ts src/cop/args.ts src/cop/struct.ts src/coa/technical.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.4.15",
    "@maat-tools/presets-ts": "workspace:*"
  },
  "dependencies": {
    "@maat-tools/contracts": "workspace:*",
    "@maat-tools/core": "workspace:*",
    "@maat-tools/vocabulary": "workspace:*"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/connascence-rules"
  }
}
