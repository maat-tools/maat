{
  "name": "@maat-tools/core",
  "version": "0.1.9",
  "description": "Orchestration layer providing MaatConfig, collector and rule entry resolution, and the base ledger backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.4.15"
  },
  "dependencies": {
    "@maat-tools/contracts": "workspace:*",
    "@maat-tools/utils": "workspace:*",
    "ulid": "3.0.2"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/core"
  }
}
