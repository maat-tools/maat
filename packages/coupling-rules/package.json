{
	"name": "@maat-tools/coupling-rules",
	"version": "0.1.1",
	"description": "Rules for enforcing import boundaries between architectural layers and packages",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./layer": {
			"import": "./dist/layer.js",
			"types": "./dist/layer.d.ts"
		},
		"./roles": {
			"import": "./dist/roles.js",
			"types": "./dist/roles.d.ts"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build src/index.ts src/layer.ts src/roles.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
		"dev": "bun run src/index.ts",
		"lint": "biome check .",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "1.3.13",
		"@biomejs/biome": "2.4.14"
	},
	"dependencies": {
		"@maat-tools/contracts": "workspace:*",
		"@maat-tools/core": "workspace:*",
		"@maat-tools/vocabulary": "workspace:*"
	},
	"author": "Marcos Defendi (https://github.com/maat-tools)",
	"homepage": "https://maat-tools.github.io/maat/",
	"repository": {
		"type": "git",
		"url": "https://github.com/maat-tools/maat",
		"directory": "packages/coupling-rules"
	}
}
