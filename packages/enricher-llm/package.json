{
  "name": "@maat-tools/enricher-llm",
  "version": "0.3.1",
  "description": "LLM-powered enrichers that consume facts from collectors and produce new probabilistic facts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./com": {
      "bun": "./src/com/index.ts",
      "import": "./dist/com/index.js",
      "types": "./dist/com/index.d.ts",
      "default": "./dist/com/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/com/index.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.5.0"
  },
  "dependencies": {
    "@maat-tools/contracts": "workspace:*",
    "@maat-tools/utils": "workspace:*",
    "@maat-tools/vocabulary": "workspace:*"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/enricher-llm"
  }
}
