{
  "name": "@maat-tools/git-rules",
  "version": "0.1.7",
  "description": "Rules derived from git history — hotspot detection and co-change analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./churn": {
      "bun": "./src/churn.ts",
      "import": "./dist/churn.js",
      "types": "./dist/churn.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/churn.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@biomejs/biome": "2.4.14"
  },
  "dependencies": {
    "@maat-tools/contracts": "0.1.6",
    "@maat-tools/collector-git": "0.1.6",
    "@types/micromatch": "^4.0.10",
    "micromatch": "^4.0.8"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/git-rules"
  }
}
