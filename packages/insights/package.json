{
  "name": "@maat-tools/insights",
  "version": "0.1.3",
  "description": "Built-in insights for maat — cross-cutting analysis over findings from multiple rule families",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./erosion": {
      "bun": "./src/erosion.ts",
      "import": "./dist/erosion.js",
      "types": "./dist/erosion.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/erosion.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@biomejs/biome": "2.4.14"
  },
  "dependencies": {
    "@maat-tools/contracts": "workspace:*"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/insights"
  }
}
