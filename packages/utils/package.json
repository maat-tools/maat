{
  "name": "@maat-tools/utils",
  "version": "0.5.0",
  "description": "Shared utilities for Maat packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --packages external && bunx tsc -p tsconfig.build.json",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@biomejs/biome": "2.5.0",
    "@types/micromatch": "4.0.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.112.4",
    "@anthropic-ai/vertex-sdk": "0.19.0",
    "@google-cloud/vertexai": "1.12.0",
    "@google/genai": "2.12.0",
    "chalk": "5.6.2",
    "jiti": "2.7.0",
    "micromatch": "4.0.8",
    "openai": "6.48.0",
    "ulid": "3.0.2",
    "@maat-tools/contracts": "workspace:*"
  },
  "author": "Marcos Defendi (https://github.com/maat-tools)",
  "homepage": "https://maat-tools.github.io/maat/",
  "repository": {
    "type": "git",
    "url": "https://github.com/maat-tools/maat",
    "directory": "packages/utils"
  }
}
