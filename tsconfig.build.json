{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"moduleResolution": "node",
		"module": "ESNext",
		"esModuleInterop": true,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": false,
		"outDir": "./dist",
		"baseUrl": ".",
		"paths": {
			"@maat-tools/contracts": ["packages/contracts/dist/index.d.ts"],
			"@maat-tools/vocabulary": ["packages/vocabulary/dist/index.d.ts"],
			"@maat-tools/core": ["packages/core/dist/index.d.ts"],
			"@maat-tools/kernel": ["packages/kernel/dist/index.d.ts"],
			"@maat-tools/collector-ts": ["packages/collector-ts/dist/index.d.ts"],
			"@maat-tools/collector-git": ["packages/collector-git/dist/index.d.ts"],
			"@maat-tools/coupling-rules": ["packages/coupling-rules/dist/index.d.ts"],
			"@maat-tools/connascence-rules": ["packages/connascence-rules/dist/index.d.ts"],
			"@maat-tools/git-rules": ["packages/git-rules/dist/index.d.ts"],
			"@maat-tools/file-ledger": ["packages/file-ledger/dist/index.d.ts"],
			"@maat-tools/insights": ["packages/insights/dist/index.d.ts"],
			"@maat-tools/cli": ["packages/cli/dist/index.d.ts"]
		}
	},
	"exclude": ["packages/cli/fixtures", "**/*.test.ts"]
}
