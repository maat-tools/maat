{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		// Workspace package resolution
		"paths": {
			"@maat-tools/testing": ["./packages/testing/src/index.ts"],
			"@maat-tools/contracts": ["./packages/contracts/src/index.ts"],
			"@maat-tools/vocabulary": ["./packages/vocabulary/src/index.ts"],
			"@maat-tools/core": ["./packages/core/src/index.ts"],
			"@maat-tools/kernel": ["./packages/kernel/src/index.ts"],
			"@maat-tools/collector-ts": ["./packages/collector-ts/src/index.ts"],
			"@maat-tools/collector-git": ["./packages/collector-git/src/index.ts"],
			"@maat-tools/enricher-llm": ["./packages/enricher-llm/src/index.ts"],
			"@maat-tools/enricher-llm/com": ["./packages/enricher-llm/src/com/index.ts"],
			"@maat-tools/utils": ["./packages/utils/src/index.ts"],
			"@maat-tools/coupling-rules": ["./packages/coupling-rules/src/index.ts"],
			"@maat-tools/coupling-rules/layer": ["./packages/coupling-rules/src/layer.ts"],
			"@maat-tools/coupling-rules/roles": ["./packages/coupling-rules/src/roles.ts"],
			"@maat-tools/connascence-rules": ["./packages/connascence-rules/src/index.ts"],
			"@maat-tools/git-rules": ["./packages/git-rules/src/index.ts"],
			"@maat-tools/git-rules/churn": ["./packages/git-rules/src/churn.ts"],
			"@maat-tools/insights": ["./packages/insights/src/index.ts"],
			"@maat-tools/insights/erosion": ["./packages/insights/src/erosion.ts"],
			"@maat-tools/file-ledger": ["./packages/file-ledger/src/index.ts"],
			"@maat-tools/cli": ["./packages/cli/src/index.ts"]
		}
	},
	"exclude": ["packages/*/fixtures", "packages/*/dist", "tests/fixtures", "tests/e2e/tsconfig.json"]
}
